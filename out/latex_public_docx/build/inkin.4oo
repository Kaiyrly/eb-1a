text:style-name="ecbx-1200">4.0</text:span><!--l. 84--><draw:frame draw:style-name="mml-inline" draw:name="mobj-6" 
text:anchor-type="as-char" draw:z-index="0" ><draw:object 
xlink:href="./inkin-m6" 
