</table:table-row><table:table-row  
 table:style-name="TBL-2-5-"><table:table-cell  
 table:style-name="TBL-2-5-1"><text:p  
text:style-name="sty-11L" >  Bureau of National Statistics  </text:p></table:table-cell><table:table-cell  
 table:style-name="TBL-2-5-2"><text:p  
text:style-name="sty-11R" >     9,105,492 KZT  </text:p></table:table-cell><table:table-cell  
 table:style-name="TBL-2-5-3"><text:p  
text:style-name="sty-11R" >        36,280,908 KZT  </text:p></table:table-cell><table:table-cell  
 table:style-name="TBL-2-5-4"><text:p  
