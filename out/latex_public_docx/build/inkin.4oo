<text:p text:style-name="center" >
 <text:span text:style-name="textbf" ><text:span 
text:style-name="ecbx-1728">Table of Contents</text:span></text:span>
</text:p><text:p text:style-name="end-env-p" ></text:p></text:section><!--end center-->
      <text:list text:style-name="Enumerate" > 

      <text:list-item>
      <text:p text:style-name="Inside-enumerate" >Form G-1145, e-Notification of Application/Petition Acceptance.
      </text:p> 
</text:list-item> 

      <text:list-item>
      <text:p text:style-name="Inside-enumerate" >Form I-140, Immigrant Petition for Alien Worker, with $700 filing fee.
      </text:p> 
</text:list-item> 

      <text:list-item>
      <text:p text:style-name="Inside-enumerate" >Form I-907, Request for Premium Processing Service, with the $2965 filing fee.
      </text:p> 
</text:list-item> 

      <text:list-item>
      <text:p text:style-name="Inside-enumerate" >Petition for Permanent Residence under Extraordinary ability (EB-1A) – Page <t4htlink 
href="#x1-2xdoc">3<!--tex4ht:ref: Body --></t4htlink>.
      </text:p> 
</text:list-item> 

      <text:list-item>
      <text:p text:style-name="Inside-enumerate" >Statement from Mr. Taximov detailing plans on how he intends to continue work in the
      United States – Page <t4htlink 
href="#x1-38001x5">90<!--tex4ht:ref: WorkPlan --></t4htlink>.
      </text:p> 
</text:list-item> 

      <text:list-item>
      <text:p text:style-name="Inside-enumerate" >List of Exhibits – Page <t4htlink 
href="#x1-38002x5">92<!--tex4ht:ref: ListOfExhibits --></t4htlink>.
      </text:p> 
</text:list-item> 

      <text:list-item>
      <text:p text:style-name="Inside-enumerate" >Exhibits 1–169 – Page <t4htlink 
href="#x1-38003x5">93<!--tex4ht:ref: Exhibits --></t4htlink>.</text:p> 
